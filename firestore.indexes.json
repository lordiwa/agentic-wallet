  "fieldOverrides": [
    {
      "//": "rawSubject es el asunto crudo del correo: no se filtra ni se ordena por el nunca, y cada indice de un campo que no se usa es escritura facturada y latencia de ingesta por nada.",
      "collectionGroup": "transactions",
      "fieldPath": "rawSubject",
      "indexes": []
    },
    {
      "//": "Idem: el id de thread de Gmail viaja para poder auditar, no para consultar.",
      "collectionGroup": "transactions",
      "fieldPath": "gmailThreadId",
