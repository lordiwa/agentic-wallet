node_modules/

# Secretos. `.env` solo cubre el nombre exacto, por eso los respaldos van aparte.
.env
.env.bak*
.env.local

# La base es el historial bancario completo: NUNCA al repo.
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

dist/
dist-demo/
build/

# Cache de deploys de Firebase Hosting (hashes de archivos ya subidos).
.firebase/

# Logs de los emuladores de Firebase (los deja en el cwd desde donde corren).
firebase-debug.log
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log
.DS_Store

# Bitacora de subagentes de hivemind: runtime local, no artefacto del repo.
state/

.claude/worktrees/
.claude/context-monitor/
**/.claude/context-monitor/

# Estados de cuenta descargados del banco (cedula, direccion, numero de
# tarjeta). Si los usas para reconstruir historial, se quedan fuera del repo.
*estado-de-cuenta*.pdf
*estado_de_cuenta*.pdf
ESTADO CUENTA*.pdf
