# El Claude Agent SDK (@anthropic-ai/claude-agent-sdk) declara un peer zod@^4, pero
# empaqueta su propio zod v4 internamente y NUNCA carga el zod externo del proyecto
# (verificado: sdk.mjs no importa/require zod externo). El proyecto usa zod@^3 en
# parser/api/config. legacy-peer-deps evita el ERESOLVE espurio de ese peer.
# Nota: por esto los peers necesarios se declaran explicitamente (p.ej.
# @testing-library/dom en web/package.json), ya que legacy-peer-deps no auto-instala peers.
legacy-peer-deps=true
