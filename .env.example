# Copia este archivo a .env y completa los valores. .env esta en .gitignore.
# `npm run onboard` te guia paso a paso y te dice cual falta.

# --- Claude -----------------------------------------------------------------
# Credencial para leer/clasificar correos y para el chat. Necesitas UNA de las
# dos.
#
# Opcion A (recomendada, suscripcion Pro/Max): corre `claude setup-token` y
# pega aqui el token que imprime. Consume tu suscripcion, no cobra por uso.
CLAUDE_CODE_OAUTH_TOKEN=
# Opcion B (API medida): API key de console.anthropic.com. Se factura por token.
# Si ambas estan seteadas, ANTHROPIC_API_KEY tiene precedencia.
ANTHROPIC_API_KEY=

# --- Gmail (solo lectura) ---------------------------------------------------
# Cliente OAuth2 tipo "Desktop app" creado en Google Cloud Console, con el
# scope gmail.readonly. Ver docs/conectar-gmail.md para el paso a paso.
# El refresh token lo genera `npm run gmail-auth` una sola vez.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# --- Local ------------------------------------------------------------------
# Ruta de la base SQLite (local-first: nada corre en la nube).
# Si vienes de iwa-wallet y tu .env dice BOLSILLO_DB_PATH, tambien se acepta
# ese nombre; con las dos seteadas gana WALLET_DB_PATH.
WALLET_DB_PATH=./wallet.sqlite

# Tu huso horario, como offset entero de UTC. Define que cuenta como "hoy" y
# "este mes" en todos los totales. Ej: -5 Quito/Lima/Bogota, -3 Buenos Aires,
# -6 Ciudad de Mexico, +1 Madrid. Default: -5.
# (No maneja horario de verano; ver server/src/strategy/dates.ts.)
WALLET_UTC_OFFSET_HOURS=-5

# Puerto del backend Express (sirve API + SPA en un solo puerto).
PORT=3000

# Interfaz donde escucha. 127.0.0.1 = solo esta maquina (default seguro).
# La API NO tiene autenticacion: en un servidor con IP publica dejalo en
# 127.0.0.1 y da el acceso remoto con `tailscale serve 3000`.
WALLET_BIND_HOST=127.0.0.1
