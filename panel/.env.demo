# Build del panel que se publica en Firebase Hosting
# (`npm run build:hosting` -> `panel/dist-demo`).
#
# `demo` no es una URL: es el valor que activa el modo demostracion del
# cliente (panel/src/api/base.ts -> `isDemoMode`), que sirve respuestas
# inventadas desde panel/src/demo/demoFetch.ts sin salir a la red. Es el
# default correcto para un hosting publico — ahi NO hay backend, y un build
# con base vacia le pegaria a un `/api` que en Firebase no existe: las cuatro
# pantallas mostrarian error.
#
# Quien mire el sitio puede proponerle su propio server desde el navegador con
# `?api=https://...`; el panel no lo aplica hasta que alguien lo confirma a
# mano, y darle la llave es una segunda decision aparte. Ver
# docs/frontend-desplegado.md.
VITE_API_BASE_URL=demo

# A proposito vacia: `VITE_API_BASE_URL` dice a quien le hablo, no a quien le
# doy la llave. El sitio publicado no autoriza a ningun backend a recibir
# credenciales — eso lo confirma cada usuario en su navegador.
VITE_WALLET_TRUSTED_API_ORIGINS=

# --- El backend del pivot: las Cloud Functions ---
#
# Otro origen y otra credencial que `VITE_API_BASE_URL`: aca la llave es un ID
# token de Firebase, no `WALLET_ACCESS_TOKEN` (ver panel/src/api/gmail.ts). El
# modo demostracion de arriba gobierna el ledger; estas funciones son reales y
# solo se llaman cuando hay sesion.
VITE_FUNCTIONS_BASE_URL=https://us-central1-agentic-wallet-71314.cloudfunctions.net

# --- Identidad: Firebase Auth (login con Google) ---
#
# Estos valores son PUBLICOS por diseno: viajan en el bundle que sirve el
# navegador de cualquiera. La `apiKey` de Firebase no es un secreto sino un
# identificador de proyecto — quien intente usarla choca con las reglas de
# Firestore y con los dominios autorizados de Auth, que son los que de verdad
# autorizan. El secreto del cliente OAuth (`client_secret`) NO esta aca ni
# puede estarlo: vive solo en las funciones.
#
# Estan en `.env.demo` y no en `.env` porque solo el build publicado necesita
# identidad. `npm run dev` y `npm run build` siguen sin Firebase, y el panel
# local sigue entrando con la llave del server: si estas variables faltan, la
# puerta de sesion no existe (ver panel/src/auth/config.ts).
#
# No hay `appId` ni `measurementId` a proposito: el proyecto no tiene ninguna
# Web App registrada y Firebase Auth no la necesita — con `apiKey`,
# `authDomain` y `projectId` alcanza. Analytics e Installations, que si la
# pedirian, no se usan.
VITE_FIREBASE_API_KEY=AIzaSyDevuaPCaOPFGesxQTG66fHPRP636XBADE
VITE_FIREBASE_AUTH_DOMAIN=agentic-wallet-71314.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agentic-wallet-71314
VITE_FIREBASE_STORAGE_BUCKET=agentic-wallet-71314.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=743241056894
