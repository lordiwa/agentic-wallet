{
  "name": "@agentic-wallet/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run build:mcp",
    "build:mcp": "node scripts/build-mcp.mjs",
    "mcp": "node dist-mcp/mcp-server.cjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "seed": "tsx src/seed/cli.ts",
    "onboard": "tsx src/onboard/cli.ts",
    "gmail-auth": "tsx scripts/gmail-auth.ts",
    "reconstruct": "tsx scripts/reconstruct.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.216",
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
