# Variables de entorno del deploy a `agentic-wallet-71314`.
#
# Firebase carga `functions/.env.<projectId>` al desplegar y al emular ese
# proyecto. Los emuladores de los tests corren con `agentic-wallet-test`
# (ver `scripts/with-emulator.mjs`), asi que este archivo no los toca.
#
# **Aca no va NINGUN secreto.** Los dos secretos —`WALLET_TOKEN_KEK` y
# `WALLET_GMAIL_CLIENT_SECRET`— viven en Secret Manager y los declara
# `defineSecret` en `src/index.ts`. Lo de este archivo es publico por
# construccion: el client_id y la redirect_uri viajan en la URL de la pantalla
# de consentimiento, a la vista de cualquiera que la abra.
#
# Este archivo SI se versiona, justamente porque un valor de estos que se
# pierda deja el deploy roto con un "falta la variable X" en runtime.

# Cliente OAuth "Bolsillo-web-client" (proyecto de Google 855144098021).
# OJO: no es el mismo cliente que usa el server viejo de escritorio.
WALLET_GMAIL_CLIENT_ID=855144098021-3u5b01htci4o86o82d13bdrq12o4m640.apps.googleusercontent.com

# Byte por byte igual a una "Authorized redirect URI" del cliente: Google
# compara strings, no URLs normalizadas. El nombre del path es el de la
# exportacion `gmailAuthCallback` de `src/index.ts` — si se renombra la funcion,
# esta URL cambia y hay que corregirla en la consola de Google tambien.
WALLET_OAUTH_REDIRECT_URI=https://us-central1-agentic-wallet-71314.cloudfunctions.net/gmailAuthCallback

# El origen del panel. Es la allowlist de una sola entrada que impide que el
# callback se use como redirector abierto (ver `oauth/config.ts`).
WALLET_PANEL_ORIGIN=https://agentic-wallet-71314.web.app
